# Server
PORT=5000
NODE_ENV=development

# MongoDB — paste URI from Heramb into your local .env (never commit .env)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
# Optional if SRV DNS fails on Windows ISP: comma-separated host:port from Atlas
# MONGO_SRV_FALLBACK_HOSTS=ac-xxx-shard-00-00.xxx.mongodb.net:27017,ac-xxx-shard-00-01.xxx.mongodb.net:27017
# MONGO_REPLICA_SET=atlas-xxxxx-shard-0

# JWT — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-me-to-a-different-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

# Frontend URL (CORS + user invite login link)
CLIENT_URL=http://localhost:5173
INVITE_LOGIN_PATH=/login

# Seed data (optional — used by npm run seed:branch)
SEED_BRANCH_NAME=Main Salon Branch
SEED_BRANCH_ADDRESS=Salon address — update after client meeting
SEED_BRANCH_PHONE=

# Dev owner user (optional — used by npm run seed:owner / seed:dev)
# Default password is documented in README.md only — do not commit real passwords here.
SEED_OWNER_NAME=Salon Owner
SEED_OWNER_PHONE=9137045588
SEED_OWNER_EMAIL=owner@s21.com
# SEED_OWNER_PASSWORD=set-locally-if-you-need-a-custom-dev-password

# Sheet 04 row 12 — online customer self-booking (Phase 2, deferred in Phase 1)
ONLINE_BOOKING_ENABLED=false

# WhatsApp Cloud API (CRM offers — Meta Business)
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_TEMPLATE_NAME=_salon_offer_image
# WHATSAPP_TEMPLATE_LANGUAGE=en
# WHATSAPP_DAILY_SEND_LIMIT=250
# WHATSAPP_SEND_DELAY_MS=350
